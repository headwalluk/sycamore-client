# Build output
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go
*.test
*.out
vendor/

# Wails
gui/build/bin/
gui/frontend/node_modules/
# Frontend build output is regenerated by `wails build`/`wails dev` and not
# tracked — but the directory must exist for the Go `//go:embed
# all:frontend/dist` to resolve on a fresh clone, so keep a placeholder.
gui/frontend/dist/*
!gui/frontend/dist/.gitkeep

# Local-only notes and planning docs (never committed: they hold internal hostnames and instance names)
dev-notes/
*.local.md

# Claude Code's per-machine tool permissions
.claude/settings.local.json

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
